{
  "name": "bsv-socialmedia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm --prefix admin-site run build",
    "catalog:sync": "node scripts/build-bsv-catalog.mjs",
    "render": "node scripts/render-story.mjs",
    "render:all": "node scripts/render-all.mjs",
    "build:edge-assets": "node scripts/generate-edge-assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:auth": "npx --yes deno@2.9.6 test --allow-env --no-check supabase/tests/suite-login-auth.test.ts",
    "test:cashbook:db": "node scripts/test-cashbook-db.mjs",
    "check": "node scripts/check-project.mjs && npm test",
    "preview": "npm run build && node scripts/preview-editorial.mjs"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "@xmldom/xmldom": "0.9.12",
    "cheerio": "1.2.0",
    "opentype.js": "1.3.4",
    "tesseract.js": "7.0.0"
  }
}
