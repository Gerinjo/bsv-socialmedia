{"/kassenbuch/manifest.webmanifest":{"type":"application/manifest+json","body":"{\"id\":\"/\",\"name\":\"BSV Nordstern · Club Suite\",\"short_name\":\"BSV Suite\",\"lang\":\"de\",\"start_url\":\"/?area=cashbook\",\"scope\":\"/\",\"display\":\"standalone\",\"description\":\"Die BSV Club Suite mit dem Kassenbuch der Jugendabteilung und deinen freigeschalteten Vereinsbereichen.\",\"prefer_related_applications\":false,\"background_color\":\"#f7f9f8\",\"theme_color\":\"#165c3d\",\"icons\":[{\"src\":\"/kassenbuch/icon-192.png\",\"sizes\":\"192x192\",\"type\":\"image/png\",\"purpose\":\"any maskable\"},{\"src\":\"/kassenbuch/icon-512.png\",\"sizes\":\"512x512\",\"type\":\"image/png\",\"purpose\":\"any maskable\"}]}"},"/suite-sw.js":{"type":"application/javascript; charset=utf-8","body":"// No caching of balances, identities, photographs, signatures or API responses.\nconst CACHE = 'bsv-cashbook-public-v5';\nconst OFFLINE = '/kassenbuch/offline';\nself.addEventListener('install', event => { event.waitUntil(caches.open(CACHE).then(cache => cache.add(OFFLINE))); self.skipWaiting(); });\nself.addEventListener('activate', event => { event.waitUntil(caches.keys().then(keys => Promise.all(keys.filter(key => key.startsWith('bsv-cashbook-public-') && key !== CACHE).map(key => caches.delete(key)))).then(() => self.clients.claim())); });\nself.addEventListener('fetch', event => {\n  const url = new URL(event.request.url);\n  if (event.request.mode !== 'navigate' || url.origin !== self.location.origin) return;\n  event.respondWith(fetch(event.request).catch(() => caches.match(OFFLINE)));\n});\n"},"/kassenbuch/offline":{"type":"text/html; charset=utf-8","body":"<!doctype html><html lang=\"de\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Kassenbuch der Jugendabteilung · Verbindung fehlt</title><style>body{margin:40px 24px;background:#f7f9f8;color:#29332f;font:18px/1.5 Roboto,Inter,Arial,sans-serif}main{max-width:500px;margin:auto}a{color:#165c3d}</style></head><body><main><h1>Internetverbindung fehlt.</h1><p>Für den aktuellen Safe-Bestand und jede Geldbuchung brauchst du eine Verbindung. Stelle sie wieder her und öffne das Kassenbuch der Jugendabteilung erneut.</p><a href=\"/?area=cashbook\">Erneut öffnen</a></main></body></html>"},"/kassenbuch/icon-192.png":{"type":"image/png","base64":true,"body":""},"/kassenbuch/icon-512.png":{"type":"image/png","base64":true,"body":""}}