STORY_RENDER_SECRET=

# Wird im Onlinebetrieb automatisch als Supabase Edge Secret und Vault-Eintrag verwaltet.
SOCIAL_WORKER_CRON_SECRET=

# Redaktion: ausschließlich als Supabase Edge Secrets setzen, nie im Browser.
