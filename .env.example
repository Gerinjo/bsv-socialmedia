# Verbundenes Supabase-Projekt (öffentliche Angaben, keine Secrets).
SUPABASE_URL=https://maejihwjzxkmthjavgnx.supabase.co
SUPABASE_PROJECT_REF=maejihwjzxkmthjavgnx
